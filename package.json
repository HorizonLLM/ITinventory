{
  "name": "it-inventory",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "IT asset inventory — Cyber Sigilism × BLAME! token-driven UI",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3001",
    "build": "npm run check && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3001 --strictPort",
    "check": "node scripts/check-theme.mjs && tsc --noEmit && node scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
